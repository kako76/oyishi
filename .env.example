# Google Analytics 4 Measurement ID
# Si se deja vacío o no se define, Analytics no se cargará.
# Ejemplo: VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# Clave de Administrador para Acceso Privado al Panel de Pedidos (/admin/pedidos)
# Configurar en Cloudflare Pages > Settings > Environment Variables
ADMIN_PASSWORD=oyishi2026

# Secreto de Autenticación para Webhook de Retell AI (Header x-retell-secret)
RETELL_WEBHOOK_SECRET=your_retell_webhook_secret_key
